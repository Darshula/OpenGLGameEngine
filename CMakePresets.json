{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-x64",
            "displayName": "Linux x86_64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "windows-x64",
            "displayName": "Windows x86_64 (MinGW)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw64.cmake"
        }
    ],
    "buildPresets": [
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x86_64 Debug",
            "configurePreset": "linux-x64",
            "configuration": "Debug"
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x86_64 Release",
            "configurePreset": "linux-x64",
            "configuration": "Release"
        },
        {
            "name": "linux-x64-relwithdebinfo",
            "displayName": "Linux x86_64 RelWithDebInfo",
            "configurePreset": "linux-x64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-x64-minsizerel",
            "displayName": "Linux x86_64 MinSizeRel",
            "configurePreset": "linux-x64",
            "configuration": "MinSizeRel"
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x86_64 Debug",
            "configurePreset": "windows-x64",
            "configuration": "Debug"
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x86_64 Release",
            "configurePreset": "windows-x64",
            "configuration": "Release"
        },
        {
            "name": "windows-x64-relwithdebinfo",
            "displayName": "Windows x86_64 RelWithDebInfo",
            "configurePreset": "windows-x64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-x64-minsizerel",
            "displayName": "Windows x86_64 MinSizeRel",
            "configurePreset": "windows-x64",
            "configuration": "MinSizeRel"
        }
    ]
}
